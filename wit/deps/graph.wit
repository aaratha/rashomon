package rashomon:graph;

/// Shared data shapes for the graph primitive: Nodes, Edges, and the
/// role that distinguishes a durable Entity from a weak-identity
/// Occurrence. See `rashomon-architecture.md` sections 1, 3, and 4.
interface types {
    /// Every Node has exactly one role, fixed by the kernel.
    enum role {
        entity,
        occurrence,
    }

    /// A single string key/value property. A placeholder for a real
    /// schema system, which is out of scope for this pass.
    record property {
        key: string,
        value: string,
    }

    /// The generic graph vertex. `node-type` is namespaced, e.g.
    /// "rashomon:page" or "someauthor:shell-session".
    record node {
        id: string,
        node-type: string,
        role: role,
        properties: list<property>,
    }

    /// A typed, directed link between two Nodes. `edge-type` mirrors
    /// `node-type` on `node` (namespaced the same way, e.g.
    /// "rashomon:references"); `source`/`target` hold Node ids, named
    /// this way (not `from`/`to`) because `from` is a reserved WIT
    /// keyword.
    record edge {
        id: string,
        edge-type: string,
        source: string,
        target: string,
        timestamp: u64,
        confidence: f32,
    }
}

/// Read/write access to Nodes and Edges. Named `store`, not `graph`, so
/// it isn't redundant with the enclosing `rashomon:graph` package.
/// Signatures only in this pass — no bodies are implemented yet.
interface store {
    use types.{role, node, edge, property};

    create-node: func(node-type: string, node-role: role, properties: list<property>) -> node;
    get-node: func(id: string) -> option<node>;
    create-edge: func(edge-type: string, source: string, target: string, confidence: f32) -> edge;
    query-edges-from: func(node-id: string) -> list<edge>;
    query-edges-to: func(node-id: string) -> list<edge>;
    /// Every Node that currently exists — for a Facet that browses or
    /// visualizes the whole graph (a graph-inspector View, say) rather
    /// than following edges out from an already-known starting point.
    list-nodes: func() -> list<node>;
    /// Every Edge that currently exists — same reasoning as `list-nodes`.
    list-edges: func() -> list<edge>;
    /// Deletes a Node and every Edge touching it. Deleting an `entity`
    /// Node cascades: every `occurrence` Node connected to it via an
    /// `occurrence-of` Edge is deleted too (an Occurrence has no
    /// identity of its own apart from the Entity it's an occurrence
    /// of, so leaving it behind orphaned would be more confusing than
    /// useful) — deleting an `occurrence` Node directly does not
    /// cascade back up to its Entity. Returns `false` if `id` didn't
    /// exist.
    delete-node: func(id: string) -> bool;
}
